@page "/"
@using Molkky.Domain
@using Molkky.Web.Infrastructure
@inherits TranslatableComponentBase
@inject NavigationManager NavigationManager

<PageTitle>@Text.NewGameLabel</PageTitle>

<div class="space-y-4">
    <h1 class="px-1 text-3xl font-bold tracking-tight">@Text.NewGameLabel</h1>

    <Card Class="space-y-4">
        @* Enter in the field adds the player, like the button. *@
        <form class="flex items-end gap-2" @onsubmit="AddPlayer">
            <TextField Label="@Text.EnterPlayerNameLabel" @bind-Value="playerName" Class="min-w-0 flex-1"
                       autocomplete="off" autocapitalize="words" enterkeyhint="done" maxlength="30" />
            <Button Type="submit" Class="min-h-12">
                <Icon Name="IconName.Plus" Class="size-5" />
                @Text.AddPlayerButton
            </Button>
        </form>

        @if (playerNames.Count > 0)
        {
            <section aria-labelledby="players-heading" class="space-y-2">
                <h2 id="players-heading" class="text-sm font-semibold text-muted">@Text.PlayersLabel</h2>
                <ul class="space-y-1">
                    @for (var i = 0; i < playerNames.Count; i++)
                    {
                        var index = i;
                        var name = playerNames[i];
                        <li class="flex items-center gap-3 rounded-xl bg-ink/5 py-1 pl-2 pr-1">
                            <Avatar Letter="@name[..1].ToUpper()" ColorClasses="bg-birch text-on-birch" />
                            <span class="min-w-0 flex-1 truncate font-medium">@name</span>
                            <IconButton Icon="IconName.Close" Label="@($"{Text.RemovePlayerButton} {name}")" OnClick="() => RemovePlayer(index)" />
                        </li>
                    }
                </ul>
            </section>
        }
    </Card>

    <Button Variant="ButtonVariant.Primary" Class="min-h-14 w-full text-lg" Disabled="@StartGameDisabled" OnClick="StartGame">@Text.StartGameButton</Button>

    @if (StartGameDisabled)
    {
        <p class="px-1 text-center text-sm text-ink/80">@Text.MinimumPlayersHint</p>
    }
</div>

@code {
    private string? playerName;
    private List<string> playerNames = new List<string>();
    private bool StartGameDisabled => playerNames.Count < 2;

    [Inject]
    private GameStore GameStore { get; set; } = default!;
    [Inject]
    private SettingsStore SettingsStore { get; set; } = default!;
    [Inject]
    private Random Random { get; set; } = default!;

    private void AddPlayer()
    {
        if (!string.IsNullOrWhiteSpace(playerName))
        {
            playerNames.Add(playerName.Trim());
            playerName = string.Empty;
        }
    }

    private void RemovePlayer(int index)
    {
        playerNames.RemoveAt(index);
    }

    private async Task StartGame()
    {
        var game = Game.Start(playerNames, await SettingsStore.Load(), Random);
        await GameStore.Save(game);

        playerNames.Clear();
        playerName = string.Empty;

        NavigationManager.NavigateTo("gameplay");
    }
}
