@page "/settings"
@using Molkky.Domain
@using Molkky.Web.Infrastructure
@inherits TranslatableComponentBase

<PageTitle>@Text.SettingsLabel</PageTitle>

<div class="space-y-4">
    <h1 class="px-1 text-3xl font-bold tracking-tight">@Text.SettingsLabel</h1>

    @if (settings is not null)
    {
        <Card Class="space-y-6">
            <SegmentedToggle TValue="MaximumPointsStrategies" Label="@Text.MaxScoreSettingDescription"
                             Options="@MaximumPointsOptions" Value="settings.MaximumPoints" ValueChanged="SetMaximumPoints" />
            <SegmentedToggle TValue="MissedThrowsStrategies" Label="@Text.MissedThrowsSettingDescription"
                             Options="@MissedThrowsOptions" Value="settings.MissedThrows" ValueChanged="SetMissedThrows" />
        </Card>

        <p class="px-1 text-sm text-ink/80">@Text.SettingsApplyToNewGames</p>
    }
</div>

@code {
    private GameSettings? settings;

    [Inject]
    private SettingsStore SettingsStore { get; set; } = default!;

    private SegmentedOption<MaximumPointsStrategies>[] MaximumPointsOptions =>
    [
        new(MaximumPointsStrategies.MaxScoreInHalf, Text.MaxScoreInHalfOption),
        new(MaximumPointsStrategies.BackToZero, Text.MaxScoreBackToZeroOption),
    ];

    private SegmentedOption<MissedThrowsStrategies>[] MissedThrowsOptions =>
    [
        new(MissedThrowsStrategies.Disqualified, Text.MissedThrowsDisqualifiedOption),
        new(MissedThrowsStrategies.BackToZero, Text.MissedThrowsBackToZeroOption),
    ];

    protected override async Task OnInitializedAsync()
    {
        settings = await SettingsStore.Load();
    }

    private Task SetMaximumPoints(MaximumPointsStrategies maximumPoints) => Save(settings! with { MaximumPoints = maximumPoints });

    private Task SetMissedThrows(MissedThrowsStrategies missedThrows) => Save(settings! with { MissedThrows = missedThrows });

    // Saved on each change; a new game starts with the saved settings.
    private Task Save(GameSettings changed)
    {
        settings = changed;
        return SettingsStore.Save(changed);
    }
}
