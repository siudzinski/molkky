@page "/gameplay"
@using Molkky.Domain
@using Molkky.Web.Infrastructure
@inherits TranslatableComponentBase
@inject NavigationManager NavigationManager

<PageTitle>Mölkky</PageTitle>

<MudContainer Class="mt-8 px-8" MaxWidth="MaxWidth.False">
    <MudGrid>
        <MudItem xs="12">
            <MudGrid Justify="Justify.FlexEnd" Spacing="0">
                <MudItem>
                    <MudIcon Icon="@Icons.Material.Filled.Alarm" />
                </MudItem>
                <MudItem>
                    <MudText>@Text.RoundLabel: @game?.RoundNumber</MudText>
                </MudItem>
            </MudGrid>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="1">
                @if (game?.CurrentPlayer != null)
                {
                    <MudGrid>
                        <MudItem xs="4">
                            <MudAvatar Size="Size.Large" Color="@PlayerColors.For(game.CurrentPlayer.ColorIndex)">@game.CurrentPlayer.FirstLetter</MudAvatar>
                        </MudItem>
                        <MudItem xs="8">
                            <MudGrid>
                                <MudItem xs="8">
                                    <MudText Typo="Typo.h5">@game.CurrentPlayer.Name</MudText>
                                    <MudText>@Text.ScoreLabel: @game.CurrentPlayer.Score</MudText>
                                </MudItem>
                                <MudItem xs="4">
                                    @if (game.CurrentPlayer.InDanger)
                                    {
                                        @for(int i = 0; i < game.CurrentPlayer.NumberOfFailedThrows; i++)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
                                        }
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                }
            </MudPaper>
        </MudItem>
        <Keyboard OnScoreAdded="AddScore" />
        <MudDivider />
        @if(game is not null)
        {
            @foreach (var player in game.Players)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard>
                        <MudCardContent>
                            <MudGrid>
                                <MudItem xs="4">
                                    <MudAvatar Size="Size.Large" Color="@PlayerColors.For(player.ColorIndex)">@player.FirstLetter</MudAvatar>
                                </MudItem>
                                <MudItem xs="8">
                                    <MudGrid>
                                        <MudItem xs="8">
                                            <MudText Typo="Typo.h6">@player.Name</MudText>
                                            <MudText>@Text.ScoreLabel: @player.Score</MudText>
                                        </MudItem>
                                        <MudItem xs="4" >
                                            @if (player.InDanger)
                                            {
                                                @for(int i = 0; i < player.NumberOfFailedThrows; i++)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
                                                }
                                            }
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
            @if(game.Losers.Any())
            {
                <MudDivider />
                @foreach (var loser in game.Losers)
                {
                    <MudItem xs="12" sm="6" md="4">
                    <MudChip Disabled="true" Class="full-width-chip" Size="Size.Large" Color="Color.Default">
                        <MudAvatar Size="Size.Large" Color="@PlayerColors.For(loser.ColorIndex)">@loser.FirstLetter</MudAvatar>
                        @loser.Name
                    </MudChip>
                </MudItem>
                }
            }
        }
    </MudGrid>
</MudContainer>

@code {
    private Game? game;

    [Inject]
    private GameStore GameStore { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        game = await GameStore.Load();
        if (game is null)
        {
            NavigationManager.NavigateTo("");
        }
        else if (game.AnyWinner)
        {
            NavigationManager.NavigateTo("endgame");
        }
    }

    // Saves every throw straight away. The winning one is saved before the endgame page reads it.
    private async Task AddScore(int score)
    {
        if (game is null) return;

        game = game.Throw(score);
        await GameStore.Save(game);

        if (game.AnyWinner)
        {
            NavigationManager.NavigateTo("endgame");
        }
    }
}
