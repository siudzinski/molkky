@page "/gameplay"
@using Molkky.Domain
@using Molkky.Web.Infrastructure
@inherits TranslatableComponentBase
@inject NavigationManager NavigationManager

<PageTitle>Mölkky</PageTitle>

@if (game is not null)
{
    var player = game.CurrentPlayer;

    <div class="space-y-4">
        <Card Class="space-y-3">
            <div class="flex items-center gap-2">
                <p class="text-sm font-medium text-muted">@Text.RoundLabel @game.RoundNumber</p>
                <div class="ml-auto flex min-w-0 items-center gap-1">
                    @if (lastThrow is { } last)
                    {
                        <p class="truncate text-sm text-muted"><span class="sr-only">@Text.LastThrowLabel: </span>@last.Name · @(last.Points == 0 ? Text.MissButton : last.Points.ToString())</p>
                    }
                    <Button Variant="ButtonVariant.Ghost" Class="-mr-2" Disabled="!game.CanUndo" OnClick="Undo">
                        <Icon Name="IconName.Undo" Class="size-5" />
                        @Text.UndoButton
                    </Button>
                </div>
            </div>

            <div class="flex items-center gap-4" aria-live="polite">
                <Avatar Large="true" Letter="@player.FirstLetter" ColorClasses="@PlayerColors.For(player.ColorIndex).Avatar" />
                <div class="min-w-0 flex-1">
                    <h1 class="truncate text-2xl font-bold">@player.Name</h1>
                    <p class="text-sm text-muted">@Text.ToWinLabel: @(Game.PointsToWin - player.Score)</p>
                </div>
                <p class="text-5xl font-extrabold tabular-nums">@player.Score</p>
            </div>

            @if (player.InDanger)
            {
                <p class="flex items-center gap-2 text-sm font-semibold text-danger">
                    <MissMarks Count="player.NumberOfFailedThrows" />
                    @Text.MissesInARowLabel
                </p>
            }
        </Card>

        <ScorePad OnThrow="Throw" />

        <Scoreboard Game="game" />
    </div>
}

@code {
    private Game? game;
    // Who made the last throw and its points: what Undo takes back.
    private (string Name, int Points)? lastThrow;

    [Inject]
    private GameStore GameStore { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var saved = await GameStore.Load();
        if (saved is null)
        {
            NavigationManager.NavigateTo("");
        }
        else if (saved.AnyWinner)
        {
            NavigationManager.NavigateTo("endgame");
        }
        else
        {
            Show(saved);
        }
    }

    private async Task Throw(int points)
    {
        if (game is null || game.AnyWinner) return;

        await Save(game.Throw(points));

        if (game.AnyWinner)
        {
            NavigationManager.NavigateTo("endgame");
        }
    }

    private async Task Undo()
    {
        if (game is not { CanUndo: true }) return;

        await Save(game.Undo());
    }

    // Saves every change straight away: each throw (the winning one before the endgame page reads it) and each undo.
    private async Task Save(Game changed)
    {
        Show(changed);
        await GameStore.Save(changed);
    }

    private void Show(Game shown)
    {
        game = shown;
        // The player before the last throw is the one who made it.
        lastThrow = shown.CanUndo ? (shown.Undo().CurrentPlayer.Name, shown.Throws[^1]) : null;
    }
}
