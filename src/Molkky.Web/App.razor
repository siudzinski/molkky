@using Molkky.Web.Infrastructure
@inject Translator Translator

@if (isLanguageInitialized)
{
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <NotFound />
            </LayoutView>
        </NotFound>
    </Router>
}
else
{
    @* The same splash as index.html, without words: the language is not known yet. *@
    <div class="grid min-h-dvh place-items-center bg-lawn text-ink">
        <p class="text-3xl font-bold tracking-tight">Mölkky</p>
    </div>
}

@code {
    private bool isLanguageInitialized;

    protected override async Task OnInitializedAsync()
    {
        await Translator.LoadLanguage();
        isLanguageInitialized = true;
    }
}
