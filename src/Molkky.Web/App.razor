@using Molkky.Web.Infrastructure
@inject Translator Translator
@inject ThemeStore ThemeStore

@if (isLoaded)
{
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <NotFound />
            </LayoutView>
        </NotFound>
    </Router>
}
else
{
    @* The same splash as index.html, without words: the language is not known yet. *@
    <div class="grid min-h-dvh place-items-center">
        <p class="text-3xl font-bold tracking-tight">Mölkky</p>
    </div>
}

@code {
    private bool isLoaded;

    // The saved language and theme, before the first page shows them.
    protected override async Task OnInitializedAsync()
    {
        await Translator.LoadLanguage();
        await ThemeStore.Load();
        isLoaded = true;
    }
}
