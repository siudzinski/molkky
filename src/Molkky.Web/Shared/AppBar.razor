@inherits TranslatableComponentBase

@* The bar on top of every page: the menu with the pages, the app's name, and the language switch. *@

<header class="sticky top-0 z-40 border-b border-stone-200 bg-stone-100/95 backdrop-blur dark:border-stone-800 dark:bg-stone-950/95">
    <div class="relative mx-auto flex h-16 max-w-md items-center gap-1 px-2">
        <IconButton Icon="IconName.Menu" Label="@Text.MenuButton" OnClick="ToggleMenu" aria-expanded="@(_menuOpen ? "true" : "false")" aria-controls="app-menu" />
        <span class="text-xl font-bold tracking-tight">Mölkky</span>
        <div class="ml-auto"><LanguageSwitch /></div>

        @if (_menuOpen)
        {
            @* A tap anywhere else closes the menu. *@
            <div class="fixed inset-0 z-40" @onclick="CloseMenu"></div>
            <nav id="app-menu" aria-label="@Text.MenuButton" class="absolute left-2 top-full z-50 mt-1 flex w-60 flex-col gap-1 rounded-2xl bg-white p-2 shadow-lg ring-1 ring-stone-200 dark:bg-stone-900 dark:ring-stone-800" @onkeydown="CloseOnEscape">
                <NavLink href="" Match="NavLinkMatch.All" class="@MenuLink" ActiveClass="@ActiveMenuLink" @onclick="CloseMenu">@Text.NewGameNavLink</NavLink>
                <NavLink href="settings" Match="NavLinkMatch.All" class="@MenuLink" ActiveClass="@ActiveMenuLink" @onclick="CloseMenu">@Text.SettingsNavLink</NavLink>
            </nav>
        }
    </div>
</header>

@code {
    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    private void CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseMenu();
    }

    private const string MenuLink =
        "flex min-h-11 items-center rounded-xl px-3 font-medium hover:bg-stone-100 dark:hover:bg-stone-800 " +
        "focus-visible:outline-2 focus-visible:outline-emerald-600 dark:focus-visible:outline-emerald-400";

    private const string ActiveMenuLink = "bg-emerald-100 text-emerald-950 dark:bg-emerald-900/60 dark:text-emerald-50";
}
