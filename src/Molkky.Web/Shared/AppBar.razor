@using Molkky.Web.Infrastructure
@inherits TranslatableComponentBase
@inject ThemeStore ThemeStore

@* The bar on top of every page: the menu with the pages, the app's name, and the light/dark switch. *@

<header class="sticky top-0 z-40 border-b border-line bg-panel backdrop-blur-md">
    <div class="relative mx-auto flex h-16 max-w-md items-center gap-1 px-2">
        <IconButton Icon="IconName.Menu" Label="@Text.MenuButton" OnClick="ToggleMenu" aria-expanded="@(_menuOpen ? "true" : "false")" aria-controls="app-menu" />
        <span class="text-xl font-bold tracking-tight">Mölkky</span>
        @* The switch to the other theme: the stylesheet shows the button that fits the theme on screen (dark: is
           data-theme on <html>), which follows the system until a theme is chosen. *@
        <span class="ml-auto flex dark:hidden"><IconButton Icon="IconName.Moon" Label="@Text.DarkThemeButton" OnClick="() => ThemeStore.SetTheme(Theme.Dark)" /></span>
        <span class="ml-auto hidden dark:flex"><IconButton Icon="IconName.Sun" Label="@Text.LightThemeButton" OnClick="() => ThemeStore.SetTheme(Theme.Light)" /></span>

        @if (_menuOpen)
        {
            @* A tap anywhere else closes the menu. *@
            <div class="fixed inset-0 z-40" @onclick="CloseMenu"></div>
            <nav id="app-menu" aria-label="@Text.MenuButton" class="absolute left-2 top-full z-50 mt-1 flex w-60 flex-col gap-1 rounded-2xl bg-surface p-2 shadow-lg ring-1 ring-line" @onkeydown="CloseOnEscape">
                <NavLink href="" Match="NavLinkMatch.All" class="@MenuLink" ActiveClass="@ActiveMenuLink" @onclick="CloseMenu">@Text.NewGameNavLink</NavLink>
                <NavLink href="settings" Match="NavLinkMatch.All" class="@MenuLink" ActiveClass="@ActiveMenuLink" @onclick="CloseMenu">@Text.SettingsNavLink</NavLink>
            </nav>
        }
    </div>
</header>

@code {
    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    private void CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseMenu();
    }

    private const string MenuLink =
        "flex min-h-11 items-center rounded-xl px-3 font-medium hover:bg-ink/5 focus-visible:outline-2 focus-visible:outline-focus";

    private const string ActiveMenuLink = "bg-highlight text-on-highlight";
}
