@using Molkky.Domain
@using Molkky.Web.Infrastructure
@inherits TranslatableComponentBase
@inject GameStore GameStore
@inject NavigationManager NavigationManager

@* Once per app start (it sits in MainLayout): offers to carry on with a saved, unfinished game. *@

@if (game is not null)
{
    <Sheet Title="@Text.ResumeGameQuestion">
        <ChildContent>
            <p class="font-medium text-ink">@string.Join(", ", game.AllPlayers.Select(player => player.Name))</p>
            <p>@Text.RoundLabel @game.RoundNumber</p>
        </ChildContent>
        <Actions>
            <Button Class="min-h-12" OnClick="NewGame">@Text.NewGameLabel</Button>
            <Button Variant="ButtonVariant.Primary" Class="min-h-12" OnClick="Resume">@Text.ResumeGameButton</Button>
        </Actions>
    </Sheet>
}

@code {
    private Game? game;

    protected override async Task OnInitializedAsync()
    {
        var saved = await GameStore.Load();
        game = saved is { AnyWinner: false } ? saved : null;
    }

    private void Resume()
    {
        game = null;
        NavigationManager.NavigateTo("gameplay");
    }

    // Discards the saved game.
    private async Task NewGame()
    {
        game = null;
        await GameStore.Clear();
        NavigationManager.NavigateTo("");
    }
}
