@inherits TranslatableComponentBase

@* Throw entry: the pins as they stand on the field, plus Miss. A tap reports the throw at once; Undo takes it back. *@

<div class="space-y-3">
    <div class="mx-auto grid max-w-80 grid-cols-8 gap-2">
        @foreach (var pin in Formation)
        {
            var points = pin.Points;
            <button type="button" class="@PinClasses @pin.Position" @onclick="() => OnThrow.InvokeAsync(points)">@points</button>
        }
    </div>

    <button type="button" class="@MissClasses" @onclick="() => OnThrow.InvokeAsync(0)">@Text.MissButton</button>
</div>

@code {
    // Points of the throw: 1-12 for a pin, 0 for a miss.
    [Parameter] public EventCallback<int> OnThrow { get; set; }

    // 7 9 8 / 5 11 12 6 / 3 10 4 / 1 2: each pin spans two of eight columns, every other row shifted by one.
    private static readonly (int Points, string Position)[] Formation =
    [
        (7, "col-start-2 row-start-1"), (9, "col-start-4 row-start-1"), (8, "col-start-6 row-start-1"),
        (5, "col-start-1 row-start-2"), (11, "col-start-3 row-start-2"), (12, "col-start-5 row-start-2"), (6, "col-start-7 row-start-2"),
        (3, "col-start-2 row-start-3"), (10, "col-start-4 row-start-3"), (4, "col-start-6 row-start-3"),
        (1, "col-start-3 row-start-4"), (2, "col-start-5 row-start-4"),
    ];

    // Birch-coloured, like the pins.
    private const string PinClasses =
        "col-span-2 aspect-square rounded-full text-2xl font-bold tabular-nums shadow-sm ring-1 transition-transform select-none touch-manipulation " +
        "bg-amber-100 text-amber-950 ring-amber-300 hover:bg-amber-200 active:scale-95 active:bg-amber-300 " +
        "dark:bg-amber-900/45 dark:text-amber-50 dark:ring-amber-700/70 dark:hover:bg-amber-900/70 dark:active:bg-amber-800 " +
        "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 dark:focus-visible:outline-emerald-400";

    private const string MissClasses =
        "flex h-14 w-full items-center justify-center rounded-2xl text-lg font-semibold transition-transform select-none touch-manipulation " +
        "bg-stone-200 text-stone-900 hover:bg-stone-300 active:scale-[0.98] active:bg-stone-400 " +
        "dark:bg-stone-800 dark:text-stone-100 dark:hover:bg-stone-700 dark:active:bg-stone-600 " +
        "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 dark:focus-visible:outline-emerald-400";
}
