@using Molkky.Web.Infrastructure
@inherits TranslatableComponentBase

@* The app's languages side by side; the choice is saved on change (Translator.SetLanguage). *@

<SegmentedToggle TValue="string" Label="@Text.LanguageLabel" HideLabel="true" Options="Options" Value="@Translator.Language" ValueChanged="Translator.SetLanguage" />

@code {
    // Each language by its code, with its own name for screen readers: "PL", read as "Polski".
    private static readonly SegmentedOption<string>[] Options =
        Translations.Languages.Select(language => new SegmentedOption<string>(language.Key, language.Key.ToUpperInvariant(), language.Value.LanguageName)).ToArray();
}
