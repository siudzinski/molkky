@* A player's misses in a row as crosses, with the count for screen readers. Nothing when there are none. *@

@if (Count > 0)
{
    <span class="inline-flex items-center gap-0.5 text-red-600 dark:text-red-400">
        @for (var i = 0; i < Count; i++)
        {
            <Icon Name="IconName.Close" Class="size-4" />
        }
        <span class="sr-only">@Count</span>
    </span>
}

@code {
    [Parameter, EditorRequired] public int Count { get; set; }
}
