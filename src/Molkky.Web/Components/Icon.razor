@* A 24×24 line icon in the current text colour. Decorative: the button or text around it carries the label. *@

<svg class="@Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case IconName.Menu:
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;
        case IconName.Close:
            <path d="M18 6 6 18M6 6l12 12" />
            break;
        case IconName.Undo:
            <path d="M9 14 4 9l5-5" />
            <path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" />
            break;
        case IconName.Trophy:
            <path d="M8 21h8M12 17v4" />
            <path d="M7 4h10v5a5 5 0 0 1-10 0z" />
            <path d="M7 6H4v1a4 4 0 0 0 3.4 3.9M17 6h3v1a4 4 0 0 1-3.4 3.9" />
            break;
        case IconName.Plus:
            <path d="M12 5v14M5 12h14" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public IconName Name { get; set; }

    [Parameter] public string Class { get; set; } = "size-6";
}
