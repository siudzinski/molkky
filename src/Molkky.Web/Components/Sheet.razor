@* A modal dialog: a sheet sliding up from the bottom on phones, a centred card on wider screens. Show it
   by rendering it; focus moves to it so screen readers announce the title. *@

<div class="fixed inset-0 z-50 flex items-end justify-center bg-black/50 backdrop-blur-sm sm:items-center sm:p-4">
    <div @ref="_dialog" role="dialog" aria-modal="true" aria-labelledby="@_titleId" tabindex="-1"
         class="w-full max-w-md rounded-t-3xl bg-surface p-6 pb-8 text-ink shadow-xl ring-1 ring-line focus:outline-none sm:rounded-3xl">
        <h2 id="@_titleId" class="text-xl font-bold">@Title</h2>
        <div class="mt-2 space-y-1 text-muted">@ChildContent</div>
        <div class="mt-6 grid auto-cols-fr grid-flow-col gap-3">@Actions</div>
    </div>
</div>

@code {
    private readonly string _titleId = ElementIds.Next("sheet-title");
    private ElementReference _dialog;

    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    // The buttons, side by side; the main one last.
    [Parameter] public RenderFragment? Actions { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _dialog.FocusAsync();
        }
    }
}
