@* A button at least 44 px tall (a comfortable touch target). Extra attributes (aria-*, autofocus, ...) go to the <button>. *@

<button type="@Type" class="@Classes" disabled="@Disabled" @onclick="OnClick" @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;

    [Parameter] public string Type { get; set; } = "button";

    [Parameter] public bool Disabled { get; set; }

    // A 44 px square for one icon, instead of padding around a text.
    [Parameter] public bool IconOnly { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    // Layout classes from the caller, e.g. "w-full".
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    // Whole class names only: Tailwind generates the classes it finds in this file.
    private string Classes => $"{Base} {(IconOnly ? "size-11" : "px-4")} {VariantClasses} {Class}";

    private const string Base =
        "inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center gap-2 rounded-xl font-semibold transition " +
        "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus disabled:cursor-not-allowed";

    private string VariantClasses => Variant switch
    {
        // Raised on an edge of a darker shade and pressed down when tapped; flat and faint when disabled.
        ButtonVariant.Primary => "bg-primary text-on-primary shadow-edge shadow-primary-edge enabled:hover:bg-primary-hover enabled:active:translate-y-0.5 enabled:active:shadow-edge-pressed disabled:bg-ink/10 disabled:text-ink/45 disabled:shadow-none",
        ButtonVariant.Ghost => "text-ink enabled:hover:bg-ink/5 enabled:active:bg-ink/10 disabled:text-ink/35",
        _ => "border border-secondary-edge bg-secondary text-ink shadow-edge shadow-secondary-edge enabled:hover:bg-secondary-hover enabled:active:translate-y-0.5 enabled:active:shadow-edge-pressed disabled:border-line disabled:bg-surface/50 disabled:text-ink/45 disabled:shadow-none",
    };
}
